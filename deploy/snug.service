[Unit]
Description=Snug thermal edge AI
After=network-online.target
[Service]
WorkingDirectory=/root/snug
Environment=PYTHONPATH=/root/unoq_deps:/root/snug
ExecStartPre=/bin/sh -c "for i in $$(seq 90); do ls /sys/bus/usb/drivers/uvcvideo 2>/dev/null | grep -q : && exit 0; sleep 1; done; exit 0"
ExecStart=/usr/bin/python3 server.py --host 0.0.0.0 --port 8080
Restart=always
RestartSec=3
[Install]
WantedBy=multi-user.target
